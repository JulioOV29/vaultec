generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activo {
  id          Int      @id @default(autoincrement())
  nombre      String
  tipo        String
  serial      String   @unique
  fechaCompra DateTime
  estado      String
  responsable String
  creadoEn    DateTime @default(now())
}